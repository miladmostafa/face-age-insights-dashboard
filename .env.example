# Face Age Client ID from https://panel.getfaceage.com/
# Required only for the live demo page that embeds the widget.
FACEAGE_CLIENT_ID=

# Write key for the seeded demo site. Leave empty to generate one during `npm run seed`.
# The seed step saves the generated key to data/demo-write-key.txt (gitignored).
DEMO_WRITE_KEY=

# SQLite file (default) or a Postgres connection string.
# Postgres example: postgres://insights:insights@localhost:5432/insights
DATABASE_URL=file:./data/insights.db

# Hide any dashboard slice with fewer than this many scans or events.
K_ANONYMITY=5

# A problem counts as a concern when its face-age score is at least this value (0-100).
CONCERN_THRESHOLD=40

# Optional. When set, the dashboard and CSV export require this token.
DASHBOARD_TOKEN=
