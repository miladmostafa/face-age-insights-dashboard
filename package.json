{
  "name": "face-age-insights-dashboard",
  "version": "0.1.0",
  "private": false,
  "description": "Open-source anonymized analytics dashboard for the face-age skin analysis widget. Collect skin concerns, skin-age buckets, skin health, and scan-to-cart conversion without storing photos or emails.",
  "keywords": [
    "face-age",
    "skin-analysis",
    "skin-age",
    "skincare-analytics",
    "anonymized-analytics",
    "conversion-funnel",
    "add-to-cart",
    "skin-health",
    "acne",
    "beauty-tech",
    "nextjs",
    "dashboard",
    "privacy"
  ],
  "homepage": "https://github.com/miladmostafa/face-age-insights-dashboard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miladmostafa/face-age-insights-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/miladmostafa/face-age-insights-dashboard/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "copy:sdk": "node scripts/copy-face-age.mjs",
    "predev": "node scripts/copy-face-age.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-face-age.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
